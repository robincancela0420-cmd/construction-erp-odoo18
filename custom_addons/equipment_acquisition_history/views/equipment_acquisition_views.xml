<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- SEARCH VIEW -->
    <record id="view_equipment_acquisition_search" model="ir.ui.view">
        <field name="name">equipment.acquisition.search</field>
        <field name="model">equipment.acquisition</field>
        <field name="arch" type="xml">
            <search string="Equipment Acquisitions">

                <field name="item"/>
                <field name="name"/>
                <field name="brand"/>
                <field name="supplier"/>
                <field name="product_id"/>
                <field name="serial_no"/>
                <field name="project_id"/>

                <group expand="0" string="Group By">

                    <filter
                        string="Item"
                        name="group_by_item"
                        context="{'group_by': 'item'}"/>

                    <filter
                        string="Brand"
                        name="group_by_brand"
                        context="{'group_by': 'brand'}"/>

                    <filter
                        string="Supplier"
                        name="group_by_supplier"
                        context="{'group_by': 'supplier'}"/>

                    <filter
                        string="Project"
                        name="group_by_project"
                        context="{'group_by': 'project_id'}"/>

                    <filter
                        string="Acquisition Year"
                        name="group_by_year"
                        context="{'group_by': 'acquisition_year'}"/>

                </group>

            </search>
        </field>
    </record>


    <!-- LIST VIEW -->
    <record id="view_equipment_acquisition_list" model="ir.ui.view">
        <field name="name">equipment.acquisition.list</field>
        <field name="model">equipment.acquisition</field>
        <field name="arch" type="xml">

            <list>
                <field name="name"/>
                <field name="item"/>
                <field name="brand"/>
                <field name="qty_acquired"/>
                <field name="current_qty"/>
                <field name="qty_difference"/>
                <field name="purchase_date"/>
                <field name="acquisition_year"/>
                <field name="supplier"/>
                <field name="unit_cost"/>
                <field name="amount"/>
                <field name="project_id"/>
            </list>

        </field>
    </record>


    <!-- FORM VIEW -->
    <record id="view_equipment_acquisition_form" model="ir.ui.view">
        <field name="name">equipment.acquisition.form</field>
        <field name="model">equipment.acquisition</field>
        <field name="arch" type="xml">

            <form string="Equipment Acquisition">

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="item"/>
                        </h1>
                    </div>

                    <group>

                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="brand"/>
                            <field name="serial_no"/>
                            <field name="project_id"/>
                        </group>

                        <group>
                            <field name="qty_acquired"/>
                            <field name="current_qty"/>
                            <field name="qty_difference"
                                   readonly="1"/>
                            <field name="unit"/>
                            <field name="purchase_date"/>
                            <field name="acquisition_year"
                                   readonly="1"/>
                        </group>

                    </group>

                    <group string="Financial Information">

                        <group>
                            <field name="unit_cost"/>
                            <field name="amount"
                                   readonly="1"/>
                            <field name="currency_id"
                                   invisible="1"/>
                        </group>

                        <group>
                            <field name="supplier"/>
                            <field name="invoice_no"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Remarks">
                            <field name="remarks"/>
                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- EQUIPMENT ACQUISITION ACTION -->
    <record id="action_equipment_acquisition" model="ir.actions.act_window">
        <field name="name">Equipment Acquisitions</field>
        <field name="res_model">equipment.acquisition</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_equipment_acquisition_search"/>
    </record>


    <!-- MENU -->
    <menuitem
        id="menu_equipment_acquisition"
        name="Historical Acquisitions"
        parent="maintenance.menu_maintenance_title"
        action="action_equipment_acquisition"
        sequence="90"/>

</odoo>