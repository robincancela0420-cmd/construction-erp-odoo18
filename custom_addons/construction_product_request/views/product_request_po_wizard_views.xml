<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_product_request_po_wizard_form" model="ir.ui.view">
        <field name="name">construction.product.request.po.wizard.form</field>
        <field name="model">construction.product.request.po.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Purchase Order">

                <group>
                    <field name="vendor_id"/>
                </group>

                <footer>
                    <button name="action_create_purchase_order"
                        string="Create Purchase Order"
                        type="object"
                        class="btn-primary"/>
                    <button string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>