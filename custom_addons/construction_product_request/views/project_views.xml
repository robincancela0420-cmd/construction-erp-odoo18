<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Project List View -->
    <record id="view_construction_project_list" model="ir.ui.view">
        <field name="name">construction.project.list</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="project_manager_id"/>
                <field name="pic_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Project Form View-->
     <record id="view_construction_project_form" model="ir.ui.view">
        <field name="name">construction.project.form</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="Project Assignment">
                        <field name="project_manager_id"/>
                        <field name="pic_id"/>
                    </group>
                    
                </sheet>
            </form>
        </field>
     </record>

     <!-- Project Action -->
    <record id="action_construction_project" model="ir.actions.act_window">
        <field name="name">Project</field>
        <field name="res_model">construction.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Project Menu -->
     <menuitem
    id="menu_construction_project"
    name="Project"
    parent="menu_construction_product_root"
    action="action_construction_project"
    sequence="2"/>
            
</odoo>