<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Project Cost List -->
    <record id="view_construction_project_cost_list" model="ir.ui.view">
        <field name="name">construction.project.cost.list</field>
        <field name="model">construction.project.cost</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="purchase_order_id"/>
                <field name="purchase_order_line_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="unit_cost"/>
                <field name="total_cost"/>
            </list>
        </field>
    </record>


    <!-- Project Cost Form -->
    <record id="view_construction_project_cost_form" model="ir.ui.view">
        <field name="name">construction.project.cost.form</field>
        <field name="model">construction.project.cost</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="purchase_order_id"/>
                        </group>

                        <group>
                            <field name="purchase_order_line_id"/>
                            <field name="product_id"/>
                        </group>
                    </group>

                    <group string="Cost">
                        <field name="quantity"/>
                        <field name="unit_cost"/>
                        <field name="total_cost" readonly="1"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- Project Cost Action -->
    <record id="action_construction_project_cost" model="ir.actions.act_window">
        <field name="name">Project Cost</field>
        <field name="res_model">construction.project.cost</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Project Cost Menu -->
    <menuitem
        id="menu_construction_project_cost"
        name="Project Cost"
        parent="menu_construction_product_root"
        action="action_construction_project_cost"
        sequence="3"/>

</odoo>