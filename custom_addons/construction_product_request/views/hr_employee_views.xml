<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <record id="view_employee_form_philippines" model="ir.ui.view">
        <field name="name">hr.employee.form.philippines</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='bank_account_id']" position="after">
                <field name="sss_number"/>
                <field name="tin_number"/>
                <field name="philhealth_number"/>
                <field name="pagibig_number"/>
            </xpath>

        </field>
    </record>
</odoo>