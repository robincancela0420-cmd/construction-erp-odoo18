<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<!-- Tree View -->
	<record id="view_construction_product_request_list" model="ir.ui.view">
		<field name="name">construction.product.request.tree</field>
		<field name="model">construction.product.request</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="request_date"/>
				<field name="requested_by"/>
				<field name="state"/>
			</list>
		</field>
	</record>

	<!-- Forn View -->
	<record id="view_construction_product_request_form" model="ir.ui.view">
		<field name="name">construction.product.request.form</field>
		<field name="model">construction.product.request</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<header>

						<button name="action_submit"
							string="Submit"
							type="object"
							class="btn-primary"
							invisible="state != 'draft'"/>

						<button name="action_approve"
							string="Approve"
							type="object"
							class="btn-success"
							invisible="state != 'submitted'"/>

						<button name="action_reject"
							string="Reject"
							type="object"
							class="btn-danger"
							invisible="state != 'submitted'"/>

						<field name="state"
							widget="statusbar"
							statusbar_visible="draft, submitted, approved, rejected"/>

					</header>


					<group>
						<field name="name"/>
						<field name="request_date"/>
						<field name="requested_by"/>
						
					</group>

					<group>
						<field name="reason"/>
					</group>

					<notebook>
						<page string="Product Line">
							<field name="line_ids">
								<list editable="bottom">
									<field name="product_id"/>
									<field name="description"/>
									<field name="quantity"/>
									<field name="uom_id"/>
								</list>
							</field>
						</page>
					</notebook>

				</sheet>
			</form>
		</field>
	</record>

	<record id="action_construction_product_request"
		model="ir.actions.act_window">

		<field name="name">Product Request</field>
		<field name="res_model">construction.product.request</field>
		<field name="view_mode">list,form</field>

	</record>

	<!-- Root Menu -->
	<menuitem
		id="menu_construction_product_root"
		name="Construction"
		sequence="99"
		web_icon="construction_product_request,static/description/icon.png"/>

	<!-- Product Request Menu -->
	<menuitem
		id="menu_product_request"
		name="Product Request"
		parent="menu_construction_product_root"
		action="action_construction_product_request"
		sequence="1"/>
</odoo>