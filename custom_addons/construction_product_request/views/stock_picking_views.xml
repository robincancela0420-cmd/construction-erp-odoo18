<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_picking_form_delivery_only" model="ir.ui.view">
        <field name="name">stock.picking.form.delivery.only</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='picking_type_id']" position="attributes">
                <attribute name="domain">[('code','=', context.get('restricted_picking_type_code'))]</attribute>
            </xpath>

        </field>
    </record>

</odoo>